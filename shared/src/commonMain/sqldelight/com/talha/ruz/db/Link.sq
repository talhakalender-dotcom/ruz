-- Gantt bağları: öncül bitince ardıl başlar (bitiş-başlangıç).
CREATE TABLE link (
    id TEXT NOT NULL PRIMARY KEY,
    predecessor_id TEXT NOT NULL,
    successor_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER,
    UNIQUE (predecessor_id, successor_id)
);

selectActive:
SELECT * FROM link WHERE deleted_at IS NULL;

-- Silinmiş aynı bağ varsa yerine yenisi yazılır (UNIQUE çakışmasın).
insert:
INSERT OR REPLACE INTO link(id, predecessor_id, successor_id, created_at, updated_at, deleted_at)
VALUES (:id, :predecessorId, :successorId, :now, :now, NULL);

softDelete:
UPDATE link SET deleted_at = :now, updated_at = :now WHERE id = :id;
