-- Aklına gelen her şey bir öğedir: iş, alışveriş, fikir, ödeme...
-- category_id boşsa öğe Gelen kutusundadır. start_at doluysa Gantt'ta görünür.
-- all_day: gün belli, saat yok (start_at o günün gece yarısı, Gantt'ta tam gün çubuğu).
-- Şema değişince migrations/ altına yeni bir .sqm eklenir; telefondaki veriler korunur.
CREATE TABLE item (
    id TEXT NOT NULL PRIMARY KEY,
    text TEXT NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    category_id TEXT,
    done INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    done_at INTEGER,
    start_at INTEGER,
    duration_min INTEGER,
    is_milestone INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    reminder_min_before INTEGER,
    sort_order REAL NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER,
    all_day INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    series_id TEXT
);

CREATE INDEX item_category ON item(category_id);
CREATE INDEX item_start ON item(start_at);

selectActive:
SELECT * FROM item WHERE deleted_at IS NULL ORDER BY sort_order, created_at;

minOrder:
SELECT coalesce(min(sort_order), 0.0) FROM item WHERE deleted_at IS NULL;

insert:
INSERT INTO item(id, text, note, category_id, done, done_at, start_at, duration_min, is_milestone,
                 reminder_min_before, sort_order, created_at, updated_at, deleted_at, all_day, series_id)
VALUES (:id, :text, '', :categoryId, 0, NULL, :startAt, :durationMin, :isMilestone,
        :reminderMinBefore, :sortOrder, :now, :now, NULL, :allDay, :seriesId);

update:
UPDATE item SET text = :text, category_id = :categoryId, start_at = :startAt, duration_min = :durationMin,
                all_day = :allDay, is_milestone = :isMilestone, reminder_min_before = :reminderMinBefore, updated_at = :now
WHERE id = :id;

setDone:
UPDATE item SET done = :done, done_at = :doneAt, updated_at = :now WHERE id = :id;

setCategory:
UPDATE item SET category_id = :categoryId, updated_at = :now WHERE id = :id;

activeIdsInCategory:
SELECT id FROM item WHERE category_id = :categoryId AND deleted_at IS NULL;

setCategoryForIds:
UPDATE item SET category_id = :categoryId, updated_at = :now WHERE id IN :ids;

softDelete:
UPDATE item SET deleted_at = :now, updated_at = :now WHERE id = :id;

restore:
UPDATE item SET deleted_at = NULL, updated_at = :now WHERE id = :id;

setSchedule:
UPDATE item SET start_at = :startAt, duration_min = :durationMin, all_day = :allDay, updated_at = :now WHERE id = :id;

-- Seriyi durdururken: bitmemiş, [fromMs] ve sonrasındaki tekrarlar silinir.
softDeleteFutureInSeries:
UPDATE item SET deleted_at = :now, updated_at = :now
WHERE series_id = :seriesId AND done = 0 AND deleted_at IS NULL AND start_at >= :fromMs;
